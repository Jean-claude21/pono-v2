# Postgres: the owner role runs migrations, the app role serves requests (it cannot bypass RLS).
PONO_DATABASE_OWNER_URL=postgres://pono_owner:change-me@localhost:5432/pono
PONO_DATABASE_URL=postgres://pono_app:change-me@localhost:5432/pono
# API
PONO_API_PORT=8787
# Tests: an existing database instead of the local Postgres started by the tests (optional).
# PONO_TEST_DATABASE_URL=postgres://postgres@localhost:5432/postgres
# Tests: where the Postgres 17 binaries live (optional on the author's machine).
# PONO_PG_BIN=C:\Users\messa\dev-tools\pgsql\bin
