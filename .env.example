# Postgres: the owner role runs migrations, the app role serves requests (it cannot bypass RLS).
PONO_DATABASE_OWNER_URL=postgres://pono_owner:change-me@localhost:5432/pono
PONO_DATABASE_URL=postgres://pono_app:change-me@localhost:5432/pono
# API
PONO_API_PORT=8787
# Tests: an existing database instead of the local Postgres started by the tests (optional).
# PONO_TEST_DATABASE_URL=postgres://postgres@localhost:5432/postgres
# Tests: where the Postgres 17 binaries live (optional on the author's machine).
# PONO_PG_BIN=C:\Users\messa\dev-tools\pgsql\bin
# 32 random bytes in base64, sealing what Pono keeps (D-007): node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PONO_SECRETS_KEY=
# The console's address: the only origin the browser sees (the console relays /auth and /v1).
PONO_PUBLIC_URL=http://localhost:3000
# Sign-in with GitHub (an OAuth app or a GitHub App), callback: <PONO_PUBLIC_URL>/auth/callback/github
PONO_GITHUB_CLIENT_ID=
PONO_GITHUB_CLIENT_SECRET=
# 1 = development sign-in (refused in production).
PONO_DEV_SIGN_IN=0
# Console → API.
PONO_API_URL=http://localhost:8787
# pnpm db:dev: port of the local development Postgres.
# PONO_DEV_DB_PORT=54340
