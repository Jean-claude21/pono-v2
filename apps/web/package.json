{
  "name": "@pono/web",
  "private": true,
  "type": "module",
  "description": "Pono's console: the workshop, in French and in English.",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "vite build",
    "start": "srvx serve --entry dist/server/server.js --static dist/client --prod --host 0.0.0.0 --port 3000",
    "typecheck": "vite build --logLevel error && tsc --noEmit",
    "check:strings": "node scripts/check-hardcoded-strings.mjs"
  },
  "dependencies": {
    "@pono/design": "workspace:*",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-start": "^1.169.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "srvx": "0.11.22"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.25.4",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
